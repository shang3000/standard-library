generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  icon        String?    @db.VarChar(32)
  description String?    @db.Text
  documents   Document[]

  @@map("categories")
}

model Document {
  id            Int          @id @default(autoincrement())
  title         String       @db.VarChar(255)
  categoryId    Int          @map("category_id")
  format        String       @db.VarChar(10)
  pages         Int          @default(0)
  fileSize      String?      @map("file_size") @db.VarChar(50)
  storageKey    String?      @unique @map("storage_key") @db.VarChar(255)
  originalName  String?      @map("original_name") @db.VarChar(255)
  mimeType      String?      @map("mime_type") @db.VarChar(100)
  priceStars    Int          @default(0) @map("price_stars")
  downloadCount Int          @default(0) @map("download_count")
  uploadTime    DateTime     @default(now()) @map("upload_time")
  coverImage    String?      @map("cover_image") @db.VarChar(500)
  description   String?      @db.Text
  isVip         Boolean      @default(false) @map("is_vip")
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  downloads     Download[]

  @@index([categoryId])
  @@index([format])
  @@index([uploadTime])
  @@index([downloadCount])
  @@index([priceStars])
  @@map("documents")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique @db.VarChar(50)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  email        String?    @unique @db.VarChar(255)
  role         UserRole   @default(USER)
  isVip        Boolean    @default(false) @map("is_vip")
  starsBalance Int        @default(50) @map("stars_balance")
  createdAt    DateTime   @default(now()) @map("created_at")
  downloads    Download[]

  @@map("users")
}

model Download {
  id           Int      @id @default(autoincrement())
  docId        Int      @map("doc_id")
  userId       Int      @map("user_id")
  starsPaid    Int      @default(0) @map("stars_paid")
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  document     Document @relation(fields: [docId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([docId])
  @@map("downloads")
}
